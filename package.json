{
  "name": "claude-a2a",
  "version": "0.1.0-dev.5",
  "description": "A2A server wrapper around Claude Agent SDK",
  "main": "dist/server.js",
  "bin": {
    "claude-a2a": "dist/server.js"
  },
  "scripts": {
    "dist": "npx tsc -p tsconfig.cli.json",
    "dev": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON --test scripts/permission-decision.test.mjs",
    "smoke:v1": "node scripts/smoke-v1.mjs",
    "smoke:cancel": "node scripts/smoke-cancel.mjs",
    "smoke:input": "node scripts/smoke-input-required.mjs",
    "smoke:permission": "node scripts/smoke-permission.mjs",
    "smoke": "npm run test:unit && npm run smoke:v1 && npm run smoke:cancel && npm run smoke:input && npm run smoke:permission"
  },
  "keywords": [
    "a2a",
    "claude",
    "cc",
    "ccsdk",
    "agent"
  ],
  "author": "Eric Abouaf <eric.abouaf@gmail.com>",
  "license": "ISC",
  "dependencies": {
    "@a2a-js/sdk": "^1.1.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.251",
    "@types/node": "^24.5.2",
    "chalk": "^5.6.2",
    "dotenv": "^17.2.2",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "repository": {
    "type": "git",
    "url": "http://github.com/ericabouaf/claude-a2a.git"
  }
}
